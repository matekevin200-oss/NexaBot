{
  "name": "nexa-owner-center-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Enhanced desktop application for the NEXA Bot Owner Center.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "hu.nexabot.ownercenter",
    "productName": "NEXA Owner Center",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app.html",
      "app.css",
      "app.js",
      "package.json"
    ],
    "artifactName": "NEXA-Owner-Center-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "NEXA-Owner-Center-Portable-${version}.${ext}"
    }
  }
}
